<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Secretaria MiguelAngelus: o MESMO programa do MiguelAngelus (..\..\app\*.cs e ..\..\lumen) compilado com SECRETARIA:
    outra pasta de dados (%LOCALAPPDATA%\SecretariaMiguelAngelus), outro nome e ícone, e a página no modo Secretaria
    (index.html?app=secretaria: só Agenda e Avisos, sincronizados com o MiguelAngelus pela nuvem da paróquia).
    Gerar:  dotnet publish -c Release -o "..\Secretaria MiguelAngelus App"
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>SecretariaMiguelAngelus</AssemblyName>
    <RootNamespace>MiguelAngelus</RootNamespace>
    <DefineConstants>$(DefineConstants);SECRETARIA</DefineConstants>
    <ApplicationIcon>..\marca\icone.ico</ApplicationIcon>
    <ApplicationManifest>..\..\app\app.manifest</ApplicationManifest>
    <Version>1.4.0</Version>
    <Product>Secretaria MiguelAngelus</Product>
    <Description>Secretaria MiguelAngelus — Agenda e avisos da paróquia</Description>
    <Copyright>Paróquia São José Operário — PASCOM</Copyright>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0162</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\app\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Management" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <!-- a mesma página do MiguelAngelus (abre no modo Secretaria; o ícone amarelo está em lumen\img\secretaria.svg) -->
  <ItemGroup>
    <Content Include="..\..\lumen\**\*" Exclude="..\..\lumen\teste\**;..\..\lumen\*.bat"
             Link="web\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
